# Settings for the PUBLIC Sepolia test network (docker-compose.sepolia.yml).
# Copy to .env.sepolia and fill in. Never share or commit .env.sepolia.

# --- Ethereum access ---------------------------------------------------------
# Free key from https://www.alchemy.com (Sepolia app) or https://www.infura.io
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Free plans are metered. Each idle block costs two calls, so roughly:
#   Alchemy (30M compute units/month): POLL_SECONDS=6 uses about 20M/month
#   Infura  (3M credits/day):          use POLL_SECONDS=12
POLL_SECONDS=6
# Alchemy's free plan allows 10 blocks per log query; others allow more.
LOG_BLOCK_RANGE=10

# --- Passwords for the key files in secrets/ ---------------------------------
# The monitor runs unattended, so it needs the guardian password here.
# The admin key is NOT used by the monitor: leave ADMIN_KEYSTORE_PASSWORD
# empty and you will be asked for it each time you use an admin tool.
GUARDIAN_KEYSTORE_PASSWORD=
ADMIN_KEYSTORE_PASSWORD=

# --- Guardian ----------------------------------------------------------------
# on: acts (blocklist / tighten / pause); dry-run: reports what it would do; off
GUARDIAN_MODE=on
# Wallets the guardian must never block (comma-separated), e.g. your admin wallet
PROTECTED_WALLETS=

# --- Telegram (same bot as before) ---------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
MIN_ALERT_SCORE=40
# "Monitor alive" message to Telegram: once an hour
HEARTBEAT_SECONDS=3600

# --- Watchdogs -------------------------------------------------------------------
# Local watchdog (same computer): alarm after this many seconds of silence
WATCHDOG_STALE_SECONDS=120
# Remote watchdog on Render (README, "Going public", step 7). Leave empty to skip.
REMOTE_WATCHDOG_URL=
