# Copy this file to .env and fill it in. Never commit .env.

# --- Telegram (leave empty to print alerts in the console instead)
# Token from @BotFather, e.g. 1234567890:AAH...
TELEGRAM_BOT_TOKEN=
# One or more chat IDs, comma-separated. Only these chats receive alerts.
TELEGRAM_CHAT_IDS=

# --- Chain (Docker sets these two itself and ignores the values here)
RPC_URL=http://127.0.0.1:8545
# Printed by: ape run deploy --network ethereum:local:node
TOKEN_ADDRESS=
# Block the token was deployed in. On start the monitor silently reads history
# from here, so it knows which wallets are established. 0 is fine locally.
START_BLOCK=0

# --- Monitor behaviour
# Alerts below this score are logged but not sent (40 = WARNING and above).
MIN_ALERT_SCORE=40
# Send a "monitor alive" message this often (seconds). 0 = never.
HEARTBEAT_SECONDS=600
# Watchdog raises MONITOR DOWN if no heartbeat for this long (seconds).
WATCHDOG_STALE_SECONDS=30

# --- Detector: auto (trained models if present, else rules), ml, or rules
DETECTOR=auto
MODEL_PATH=models/guard_model.joblib

# --- Phase 4 guardian: off (alerts only), dry-run (report what it would do), or on
# (Docker turns it "on" for the local chain unless you set it here.)
GUARDIAN_MODE=
# Guardian key. Leave empty on the LOCAL chain (the public test key is used).
# On any public network set a real key here, and keep this file private.
GUARDIAN_PRIVATE_KEY=
# Wallets the guardian must never blocklist (exchanges, treasury...), comma-separated.
PROTECTED_WALLETS=

# --- Files (defaults are fine)
SIGNING_KEY_PATH=keys/monitor_ed25519.key
HEARTBEAT_PATH=monitor_heartbeat.json
ALERT_LOG_PATH=alerts.jsonl
THREAT_PATH=threat.json
